# Copy to /etc/stockflow/stockflow.env on the server: root-owned, chmod 0600.
# systemd reads it at start, so a change needs `systemctl restart stockflow`.

# The origin users reach, exactly as nginx serves it. Better Auth compares the
# Origin header against this and refuses its own requests if they disagree.
APP_URL=https://stockflow.example.com
PORT=3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# openssl rand -base64 32
#
# Losing or changing this makes every stored Gemini key undecryptable, and
# there is no rotation path: users would have to paste their keys again. Back
# it up somewhere that is not this box.
ENCRYPTION_SECRET=

# Absolute path, on a filesystem that gets backed up. ReadWritePaths in
# stockflow.service has to contain its directory.
DATABASE_URL=file:/srv/stockflow/data/stockflow.db

# Sign-in is Google-only; the app throws at startup without both.
#
# console.cloud.google.com -> APIs & Services -> Credentials ->
#   Create credentials -> OAuth client ID -> Web application
# Authorised redirect URIs (both, exactly):
#   https://stockflow.example.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console = stdout, visible in `journalctl -u stockflow`. Switch to resend
# when the app starts sending anything users must receive.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@stockflow.example.com
EMAIL_FROM_NAME=Stockflow
# RESEND_API_KEY=

# Only needed once a paid tool exists; checkout is not wired up.
# POLAR_WEBHOOK_SECRET=
